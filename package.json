{
  "name": "playwright-practice",
  "version": "1.0.0",
  "description": "Enterprise BDD Test Automation Framework — Playwright + Cucumber + TypeScript",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "bdd:ui": "cross-env TEST_ENV=dev cucumber-js --config=lib/configs/cucumber.ui.yml",
    "bdd:api": "cross-env TEST_ENV=dev cucumber-js --config=lib/configs/cucumber.api.yml",
    "bdd:db": "cross-env TEST_ENV=dev cucumber-js --config=lib/configs/cucumber.db.yml",
    "bdd:all": "npm run bdd:ui && npm run bdd:api && npm run bdd:db",
    "bdd:smoke": "cross-env TEST_ENV=dev cucumber-js --config=lib/configs/cucumber.ui.yml --tags @smoke",
    "allure:generate": "allure generate allure-results/bdd -o allure-report --clean",
    "allure:serve": "allure serve allure-results/bdd",
    "allure:open": "allure open allure-report",
    "allure:bdd": "allure serve allure-results/bdd",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,yml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,yml,md}\"",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist allure-results allure-report playwright-report test-results"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "mssql": "^11.0.1",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.0",
    "@types/mssql": "^9.1.5",
    "@types/newman": "^5.3.6",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "allure-commandline": "^2.30.0",
    "allure-cucumberjs": "^3.0.0",
    "allure-js-commons": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^1.6.0",
    "newman": "^6.2.2",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "typescript",
    "bdd",
    "automation"
  ],
  "author": "Celcom Solutions",
  "license": "ISC"
}
